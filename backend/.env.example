# ===== App =====
APP_NAME=LegalEase AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ===== Security =====
SECRET_KEY=change-me-to-a-256-bit-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Database =====
DATABASE_URL=postgresql+psycopg2://legalease:legalease_dev_pw@localhost:5432/legalease
DATABASE_ECHO=false

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===== OpenAI =====
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ===== Sentence Transformers =====
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# ===== FAISS =====
FAISS_INDEX_PATH=./storage/faiss/legal_corpus.faiss
FAISS_METADATA_PATH=./storage/faiss/legal_corpus_meta.json

# ===== Tesseract OCR =====
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=eng+urd

# ===== Storage =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
DOC_MAX_SIZE_MB=20

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@legalease.ai
SMTP_TLS=true

# ===== RAG =====
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
